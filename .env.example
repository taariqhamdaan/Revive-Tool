FLASK_ENV=production
SECRET_KEY=change-me
APP_NAME=Rivive Speciality Care Hospital
APP_URL=http://127.0.0.1:5000

DATABASE_URL=postgresql://user:password@localhost:5432/rivive_db

# Fernet key for encrypting sensitive fields. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# No SMTP configured yet — keep mail suppressed in every environment until it is.
MAIL_SUPPRESS_SEND=1

# Used only by `flask seed`, to create the first SuperAdmin login.
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_EMAIL=admin@rivive.local
SEED_ADMIN_PASSWORD=
