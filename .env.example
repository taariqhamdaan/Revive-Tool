# Copy to .env for local development. Never commit the real .env.

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string

# Local default is SQLite. On Railway this is injected automatically
# by the Postgres plugin as ${{Postgres.DATABASE_URL}}
DATABASE_URL=sqlite:///rivive.db

# Set to 0 only for local API testing. Keep 1 in production.
WTF_CSRF_ENABLED=1

# Credentials created by `flask seed`
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_EMAIL=admin@rivive.local
SEED_ADMIN_PASSWORD=change-me-now
